meta {
  name: Add Address
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/users/1/addresses
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "label": "Home",
