meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
}

body:json {
  {
    "username": "newuser",
    "password": "password"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body?.accessToken || body?.token || body?.data?.accessToken || body?.data?.token;
  if (token) {
    bru.setVar("accessToken", token);
  }
}
